// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// Node.js + npm, required by the Claude Code CLI feature below.
		"ghcr.io/devcontainers/features/node:1": {},
		// Installs the Claude Code CLI (`claude`) so it's available by default.
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
		// Lightweight desktop (Xvfb + Fluxbox) served over noVNC so GUI apps
		// like software/register_cards.py can run. Sets DISPLAY=:1 in the
		// container. Open the forwarded port 6080 in a browser; password: vscode.
		"ghcr.io/devcontainers/features/desktop-lite:1": {}
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Install the Claude Code VS Code extension automatically.
			"extensions": [
				"anthropic.claude-code"
			]
		}
	},

	// Persist Claude Code's login across container rebuilds so you don't have to
	// re-authenticate every time you reopen the container. The named volume
	// outlives the container and holds ~/.claude (which includes
	// .credentials.json). More info: https://containers.dev/implementors/json_reference/#mounts
	"mounts": [
		"source=attendance-claude-home,target=/home/vscode/.claude,type=volume",
		// Persist the arduino-cli toolchain across rebuilds -- the ESP32 core pulls
		// ~5 GB of compilers, so firmware/setup-arduino.sh should only pay that once.
		"source=attendance-arduino-data,target=/home/vscode/.arduino15,type=volume",
		"source=attendance-arduino-libs,target=/home/vscode/Arduino,type=volume"
	],

	// - Give the vscode user ownership of the mounted volumes (named volumes are
	//   created root-owned on first use, before this runs).
	// - Keep ~/.claude.json (CLI state: auth account, onboarding, project trust)
	//   on the persistent volume via a symlink so it survives rebuilds too.
	// - Trust the workspace repo so git doesn't flag "dubious ownership"
	//   (the bind-mounted /workspaces path can look owner-mismatched to git).
	// - Install the arduino-cli *binary* only (tiny). The ESP32 core + libraries
	//   (~5 GB) are left to ./firmware/setup-arduino.sh so a rebuild doesn't pull
	//   them for people who never touch firmware; the volume above caches them.
	"postCreateCommand": "sudo mkdir -p /home/vscode/.arduino15 /home/vscode/Arduino && sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.arduino15 /home/vscode/Arduino && { [ -f /home/vscode/.claude/.claude.json ] || cp /home/vscode/.claude.json /home/vscode/.claude/.claude.json 2>/dev/null || echo '{}' > /home/vscode/.claude/.claude.json; }; ln -sf /home/vscode/.claude/.claude.json /home/vscode/.claude.json; git config --global --add safe.directory ${containerWorkspaceFolder}; sudo apt-get update && sudo apt-get install -y socat; pip3 install -r ${containerWorkspaceFolder}/requirements-dev.txt; if ! command -v arduino-cli >/dev/null; then mkdir -p /home/vscode/.local/bin && curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | BINDIR=/home/vscode/.local/bin sh || echo 'arduino-cli install failed -- run ./firmware/setup-arduino.sh'; fi",

	// The board's USB serial port lives on the host and cannot be passed into a
	// Docker Desktop (macOS/Windows) container. Instead the host runs a socat
	// TCP bridge and the container maps that socket to a local PTY -- see
	// software/SERIAL_BRIDGE.md. This makes host.docker.internal resolve on a
	// Linux Docker host too (it already resolves under Docker Desktop).
	"runArgs": ["--add-host=host.docker.internal:host-gateway"],

	// 6080 = noVNC (browser desktop), 5901 = raw VNC (for a native VNC client).
	"forwardPorts": [6080, 5901],
	"portsAttributes": {
		"6080": { "label": "Desktop (noVNC)" },
		"5901": { "label": "Desktop (VNC)" }
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
